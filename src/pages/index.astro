---
import Layout from "../layouts/layouts.astro";
import portrait from '../images/william-mison-portrait.png';
---
<Layout title="Wordpress and Elementor Expert">
    <!-- banner -->
    <div class="banner section">
        <div class="grid-2">
            <div class="grid-left home-left">
                <div class="bubble">
                    Hi! it’s me!
                </div>
                <h1>William Mison</h1>
                <h3>Web developer and Designer</h3>
                <p>Creative developer from Philippines.<br>I create simple yet expertly coded designs.</p>
                <div class="btn-wrapper">
                    <a class="btn" href="mailto:misonwilliam@gmail.com">Contact Me!</a>
                    <a class="btn more-me" href="/about">Get to know more!</a>
                </div>
            </div>
            <div class="grid-right home-right">
                <img src={portrait} alt="william mison portrait">
            </div>
        </div>
    </div>
    <!-- showcase -->
    <div class="one-full pad-top-50 mar-bot-50">
        <h2 class="text-align-center mar-bot-30">Are You Looking For?</h2>
        <div class="tab-nav mar-bot-50">
            <ul>
                <li><a href="#builder" class="tab-item-btn active">Builder</a></li>
                <li><a href="#designer" class="tab-item-btn">Designer</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div id="builder" class="tab-item active">
                <div class="grid-2">
                    <div class="grid-left">
                        <h2 class="mar-bot-10">Looking for Someone to Build Your Design?</h2>
                        <p class="mar-bot-30">You have a design and looking for someone to build it, I got You!  I transform your Figma, XD or Photoshop designs into pixel-perfect WordPress websites, ensuring every detail, every spacing, and every creative flourish is flawlessly replicated. Get a stunning, responsive, and easy-to-manage WordPress site that looks exactly like your masterpiece.</p>
                        <a class="btn mar-top-30" href="mailto:misonwilliam@gmail.com">Let get Started!</a>
                    </div>
                    <div class="grid-right">
                        <img src="https://elementor.com/cdn-cgi/image/f=auto,w=1200,h=736/https://elementor.com/wp-content/uploads/2018/12/Homepage_Design_Optimised.png" alt="web builder">
                    </div>
                </div>
            </div>
            <div id="designer" class="tab-item">
                <div class="grid-2">
                    <div class="grid-left">
                        <h2 class="mar-bot-10">Need a Design? I got You!</h2>
                        <p class="mar-bot-30">If you’re looking for a design or simple need to improve your website over-all look, I got you! I specialize in crafting bespoke web and brand designs that not only look incredible but also drive real results for your business. From captivating websites that engage your audience to cohesive brand identities that leave a lasting impression, we're here to bring your unique vision to life. Let's build something amazing together.</p>
                        <a class="btn mar-top-30" href="mailto:misonwilliam@gmail.com">Let get Started!</a>
                    </div>
                    <div class="grid-right">
                        <img src="https://cdn.sanity.io/images/599r6htc/regionalized/3225dab2b34419e6bc17bf52633ed13b4e86cd6d-3262x1836.jpg?rect=1,0,3260,1836&w=1632&h=919&q=75&fit=max&auto=format" alt="web designer">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- work cta -->
    <div class="one-full pad-top-50">
        <div class="bottom-cta">
            <div class="one-full">
                <h2 class="mar-bot-10">Need a Visual Proof? Check out My Recent Projects</h2>
                <p class="mar-bot-30">Browse my collection of  responsive, user-friendly, and high-performing project/website I have worked with.</p>
                <a class="btn" href="/work">Check it out!</a>
            </div>
        </div>
    </div>
    <!-- email and tagline -->
    <div class="tagline">
        <h2>Bringing amazing ideas to Life!</h2>
        <a href="mailto:misonwilliam@gmail.com"><i class="mdi mdi-email-outline"></i>misonwilliam@gmail.com</a> | 
        <a href="https://join.skype.com/invite/WniJAaB8z45v" target="_blank"><i class="mdi mdi-skype"></i>live:misonwilliam</a>
    </div>
</Layout>